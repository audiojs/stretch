{
  "name": "@audio/stretch-pvsola",
  "version": "1.0.0",
  "description": "PVSOLA time stretching: a phase-locked vocoder reset to the input's own waveform where it fits; speech slowed without flanging or phasiness",
  "type": "module",
  "sideEffects": false,
  "main": "pvsola.js",
  "types": "pvsola.d.ts",
  "exports": {
    ".": "./pvsola.js",
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "pvsola.js",
    "pvsola.d.ts",
    "README.md",
    "LICENSE",
    "util.js",
    "audio.js",
    "audio.d.ts"
  ],
  "dependencies": {
    "fourier-transform": "^2.5.0",
    "@audio/spectral-pvoc": "^1.1.0"
  },
  "keywords": [
    "audio",
    "dsp",
    "time-stretch",
    "pvsola",
    "phase-vocoder",
    "shape-invariant",
    "speech"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "homepage": "https://github.com/audiojs/stretch/tree/main/packages/stretch-pvsola",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/stretch.git",
    "directory": "packages/stretch-pvsola"
  },
  "bugs": "https://github.com/audiojs/stretch/issues",
  "engines": {
    "node": ">=18"
  },
  "audio": "./audio.js",
  "funding": "https://github.com/sponsors/audiojs"
}
